# Скопируй в .env и впиши свои ключи. .env в git не попадает.

# Сценарии: любой из двух
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# Озвучка ElevenLabs. Без ключа — бесплатный Edge TTS (голос Светланы)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Музыка подложкой (твой трек «Метаморфозис»), путь к mp3
MUSIC_PATH=
MUSIC_VOLUME=0.12
