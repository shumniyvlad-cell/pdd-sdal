{"audio":"t01/q17.mp3","engine":"edge:ru-RU-SvetlanaNeural","duration":29.13,"lines":[{"text":"Хочешь катать человека на мотоцикле? Нужны две вещи.","start":0.35,"end":4.581,"words":[{"w":"Хочешь","s":0.35,"e":0.834},{"w":"катать","s":0.834,"e":1.187},{"w":"человека","s":1.187,"e":1.694},{"w":"на","s":1.694,"e":1.765},{"w":"мотоцикле?","s":1.765,"e":2.473},{"w":"Нужны","s":3.342,"e":3.873},{"w":"две","s":3.873,"e":4.074},{"w":"вещи.","s":4.074,"e":4.581}]},{"text":"Первое: права категории А или подкатегории А-один. Права на машину не подходят.","start":5.878,"end":11.665,"words":[{"w":"Первое:","s":5.878,"e":6.409},{"w":"права","s":6.527,"e":6.798},{"w":"категории","s":6.798,"e":7.435},{"w":"А","s":7.435,"e":7.635},{"w":"или","s":7.635,"e":7.812},{"w":"подкатегории","s":7.812,"e":8.567},{"w":"А-один.","s":8.567,"e":9.156},{"w":"Права","s":10.014,"e":10.356},{"w":"на","s":10.356,"e":10.439},{"w":"машину","s":10.439,"e":10.887},{"w":"не","s":10.887,"e":10.993},{"w":"подходят.","s":10.993,"e":11.665}]},{"text":"Второе: стаж с этими правами — два года и больше.","start":12.966,"end":16.244,"words":[{"w":"Второе:","s":12.966,"e":13.567},{"w":"стаж","s":13.674,"e":14.016},{"w":"с","s":14.016,"e":14.098},{"w":"этими","s":14.098,"e":14.369},{"w":"правами","s":14.369,"e":14.853},{"w":"два","s":14.982,"e":15.207},{"w":"года","s":15.207,"e":15.643},{"w":"и","s":15.643,"e":15.725},{"w":"больше.","s":15.725,"e":16.244}]},{"text":"Есть права А, но нет стажа — ещё рано. Стаж с любыми другими правами — тоже мимо.","start":17.486,"end":23.698,"words":[{"w":"Есть","s":17.486,"e":17.899},{"w":"права","s":17.899,"e":18.3},{"w":"А,","s":18.3,"e":18.524},{"w":"но","s":18.642,"e":18.771},{"w":"нет","s":18.771,"e":18.96},{"w":"стажа","s":18.96,"e":19.385},{"w":"ещё","s":19.514,"e":19.785},{"w":"рано.","s":19.786,"e":20.198},{"w":"Стаж","s":21.068,"e":21.504},{"w":"с","s":21.504,"e":21.563},{"w":"любыми","s":21.563,"e":21.952},{"w":"другими","s":21.952,"e":22.33},{"w":"правами","s":22.33,"e":22.837},{"w":"тоже","s":22.955,"e":23.226},{"w":"мимо.","s":23.226,"e":23.698}]},{"text":"Ответ: только А или А-один, и стаж от двух лет.","start":24.982,"end":28.319,"words":[{"w":"Ответ:","s":24.982,"e":25.607},{"w":"только","s":25.713,"e":26.114},{"w":"А","s":26.114,"e":26.291},{"w":"или","s":26.291,"e":26.503},{"w":"А-один,","s":26.503,"e":27.046},{"w":"и","s":27.175,"e":27.258},{"w":"стаж","s":27.258,"e":27.576},{"w":"от","s":27.576,"e":27.659},{"w":"двух","s":27.659,"e":27.907},{"w":"лет.","s":27.907,"e":28.319}]}]}