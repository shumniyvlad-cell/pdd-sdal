{"audio":"t01/q10.mp3","engine":"edge:ru-RU-SvetlanaNeural","duration":27.594,"lines":[{"text":"Едем за городом по левой полосе. Над ней висит синий круг с цифрой пятьдесят.","start":0.35,"end":5.736,"words":[{"w":"Едем","s":0.35,"e":0.822},{"w":"за","s":0.822,"e":0.963},{"w":"городом","s":0.963,"e":1.376},{"w":"по","s":1.376,"e":1.506},{"w":"левой","s":1.506,"e":1.777},{"w":"полосе.","s":1.777,"e":2.308},{"w":"Над","s":3.13,"e":3.472},{"w":"ней","s":3.472,"e":3.661},{"w":"висит","s":3.661,"e":3.979},{"w":"синий","s":3.979,"e":4.309},{"w":"круг","s":4.309,"e":4.604},{"w":"с","s":4.604,"e":4.699},{"w":"цифрой","s":4.699,"e":5.052},{"w":"пятьдесят.","s":5.052,"e":5.736}]},{"text":"Синий круг — это минимальная скорость. Медленнее пятидесяти в этой полосе нельзя.","start":6.982,"end":12.663,"words":[{"w":"Синий","s":6.982,"e":7.454},{"w":"круг","s":7.454,"e":7.796},{"w":"это","s":8.114,"e":8.303},{"w":"минимальная","s":8.303,"e":8.869},{"w":"скорость.","s":8.869,"e":9.506},{"w":"Медленнее","s":10.293,"e":10.93},{"w":"пятидесяти","s":10.93,"e":11.59},{"w":"в","s":11.59,"e":11.649},{"w":"этой","s":11.649,"e":11.838},{"w":"полосе","s":11.838,"e":12.215},{"w":"нельзя.","s":12.215,"e":12.663}]},{"text":"Табличка со стрелкой вниз говорит: правило только для этой полосы.","start":13.926,"end":17.582,"words":[{"w":"Табличка","s":13.926,"e":14.468},{"w":"со","s":14.468,"e":14.598},{"w":"стрелкой","s":14.598,"e":14.999},{"w":"вниз","s":14.999,"e":15.223},{"w":"говорит:","s":15.223,"e":15.73},{"w":"правило","s":15.931,"e":16.332},{"w":"только","s":16.332,"e":16.662},{"w":"для","s":16.662,"e":16.827},{"w":"этой","s":16.827,"e":17.051},{"w":"полосы.","s":17.051,"e":17.582}]},{"text":"А верхний предел обычный: для легковушки за городом — девяносто.","start":18.878,"end":22.428,"words":[{"w":"А","s":18.878,"e":19.067},{"w":"верхний","s":19.067,"e":19.444},{"w":"предел","s":19.444,"e":19.774},{"w":"обычный:","s":19.774,"e":20.305},{"w":"для","s":20.435,"e":20.564},{"w":"легковушки","s":20.564,"e":21.13},{"w":"за","s":21.13,"e":21.248},{"w":"городом","s":21.248,"e":21.661},{"w":"девяносто.","s":21.779,"e":22.428}]},{"text":"Ответ: не меньше пятидесяти и не больше девяноста.","start":23.662,"end":26.787,"words":[{"w":"Ответ:","s":23.662,"e":24.204},{"w":"не","s":24.452,"e":24.594},{"w":"меньше","s":24.594,"e":24.9},{"w":"пятидесяти","s":24.9,"e":25.631},{"w":"и","s":25.631,"e":25.749},{"w":"не","s":25.749,"e":25.855},{"w":"больше","s":25.855,"e":26.162},{"w":"девяноста.","s":26.162,"e":26.787}]}]}