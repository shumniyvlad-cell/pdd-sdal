{"audio":"t01/q14.mp3","engine":"edge:ru-RU-SvetlanaNeural","duration":32.058,"lines":[{"text":"Перекрёсток без знаков и светофоров. Мы едем прямо, а тут два трамвая. Кого пропускаем?","start":0.35,"end":7.918,"words":[{"w":"Перекрёсток","s":0.35,"e":0.963},{"w":"без","s":0.963,"e":1.128},{"w":"знаков","s":1.128,"e":1.706},{"w":"и","s":1.706,"e":1.8},{"w":"светофоров.","s":1.8,"e":2.591},{"w":"Мы","s":3.449,"e":3.673},{"w":"едем","s":3.673,"e":4.015},{"w":"прямо,","s":4.015,"e":4.439},{"w":"а","s":4.569,"e":4.71},{"w":"тут","s":4.71,"e":4.923},{"w":"два","s":4.923,"e":5.135},{"w":"трамвая.","s":5.135,"e":5.878},{"w":"Кого","s":6.739,"e":7.092},{"w":"пропускаем?","s":7.092,"e":7.918}]},{"text":"Сначала главное: на равнозначном перекрёстке трамвай важнее машины.","start":9.19,"end":13.023,"words":[{"w":"Сначала","s":9.19,"e":9.768},{"w":"главное:","s":9.768,"e":10.31},{"w":"на","s":10.44,"e":10.511},{"w":"равнозначном","s":10.511,"e":11.159},{"w":"перекрёстке","s":11.159,"e":11.678},{"w":"трамвай","s":11.678,"e":12.091},{"w":"важнее","s":12.091,"e":12.492},{"w":"машины.","s":12.492,"e":13.023}]},{"text":"Значит, пропускаем обоих. А между собой они решают по правилу правой руки.","start":14.31,"end":19.838,"words":[{"w":"Значит,","s":14.31,"e":15.006},{"w":"пропускаем","s":15.124,"e":15.749},{"w":"обоих.","s":15.749,"e":16.315},{"w":"А","s":17.173,"e":17.35},{"w":"между","s":17.35,"e":17.621},{"w":"собой","s":17.621,"e":17.986},{"w":"они","s":17.986,"e":18.222},{"w":"решают","s":18.222,"e":18.623},{"w":"по","s":18.623,"e":18.729},{"w":"правилу","s":18.729,"e":19.118},{"w":"правой","s":19.119,"e":19.413},{"w":"руки.","s":19.413,"e":19.838}]},{"text":"У трамвая А справа трамвай Б. Поэтому первым едет Б, за ним А.","start":21.134,"end":26.155,"words":[{"w":"У","s":21.134,"e":21.299},{"w":"трамвая","s":21.299,"e":21.853},{"w":"А","s":21.853,"e":21.983},{"w":"справа","s":21.983,"e":22.36},{"w":"трамвай","s":22.36,"e":22.773},{"w":"Б.","s":22.773,"e":23.068},{"w":"Поэтому","s":23.914,"e":24.421},{"w":"первым","s":24.421,"e":24.799},{"w":"едет","s":24.799,"e":25.117},{"w":"Б,","s":25.117,"e":25.341},{"w":"за","s":25.471,"e":25.659},{"w":"ним","s":25.659,"e":25.86},{"w":"А.","s":25.86,"e":26.155}]},{"text":"И только потом мы. Ответ: обоим трамваям.","start":27.382,"end":31.165,"words":[{"w":"И","s":27.382,"e":27.559},{"w":"только","s":27.559,"e":27.854},{"w":"потом","s":27.854,"e":28.219},{"w":"мы.","s":28.219,"e":28.502},{"w":"Ответ:","s":29.372,"e":29.915},{"w":"обоим","s":30.186,"e":30.551},{"w":"трамваям.","s":30.551,"e":31.165}]}]}